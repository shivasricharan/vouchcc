# Copy this file to .env.local and fill in values

# Google Apps Script Web App URL (required for lead form submissions)
# See README.md → "Google Sheets Backend Setup" for how to get this URL
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=PASTE_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE

# App URL
NEXT_PUBLIC_SITE_URL=https://yourvouch.com

# Email notifications (future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your_app_password
# NOTIFY_EMAIL=leads@yourbusiness.com
